<?xml version="1.0"?><!--
  Para obtener más información sobre cómo configurar la aplicación de ASP.NET, visite
  http://go.microsoft.com/fwlink/?LinkId=169433
  --><configuration>
  <connectionStrings>
    <add name="Local" connectionString="Data Source=10.0.0.23;Initial Catalog=SIIMVA;User ID=general" providerName="System.Data.SqlClient"/>
    <add name="Siimva" connectionString="Database=Siimva;Server=10.0.0.23;User ID=general;Password=;" providerName="System.Data.SqlClient"/>
    <add name="SIIMVAConnectionString" connectionString="Data Source=10.0.0.23;Initial Catalog=Siimva;Integrated Security=True"
    
  providerName="System.Data.SqlClient"/>
    <add name="SIIMVAConnectionString1" connectionString="Data Source=10.0.0.23;Initial Catalog=SIIMVA;Integrated Security=True"
    
  providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="path" value="LDAP://municipalidad.villaallende.gov.ar/DC=municipalidad, DC=villaallende, DC=gov, DC=ar"/>
    <add key="CrystalImageCleaner-AutoStart" value="true"/>
    <add key="CrystalImageCleaner-Sleep" value="60000"/>
    <add key="CrystalImageCleaner-Age" value="120000"/>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>

    <add key="msjAfipVerificada" value="Factura/s constatada/s ante AFIP de manera automática"/>
    <add key="msjAfipNoVerificada"
    
  value="Factura/s NO constatadas por ser orden con contrato, presupuesto u otro documento valido – se deberá cargar la Factura en la Orden de Pago."/>
    <add key="imgAfip" value="120000"/>
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.6">

    </compilation>
    <httpRuntime targetFramework="4.6"/>
    <authentication mode="Forms">
      <forms loginUrl="login.aspx" defaultUrl="login.aspx" timeout="60"/>
    </authentication>
    <authorization>
      <allow users="*"/>
    </authorization>
    <httpHandlers>
      <add verb="GET" path="CrystalImageHandler.aspx"
        type="CrystalDecisions.Web.CrystalImageHandler, CrystalDecisions.Web, Version=13.0.3500.0, Culture=neutral, PublicKeyToken=692fbea5521e1304"/>
    </httpHandlers>
    <customErrors mode="Off"/>
  </system.web>
  <location path="Secure">
    <system.web>
      <authorization>
        <deny users="?"/>
      </authorization>
    </system.web>
  </location>
  <system.webServer>
      
    <validation validateIntegratedModeConfiguration="false"/>
  <handlers><add name="CrystalImageHandler.aspx_GET" verb="GET" path="CrystalImageHandler.aspx"
  type="CrystalDecisions.Web.CrystalImageHandler, CrystalDecisions.Web, Version=13.0.3500.0, Culture=neutral, PublicKeyToken=692fbea5521e1304"
  preCondition="integratedMode"/></handlers></system.webServer>
         <system.serviceModel>
             <bindings>
                 <basicHttpBinding>
                     <binding name="WSAFIPSoap"/>
                 </basicHttpBinding>
             </bindings>
             <client>
                 <endpoint address="http://10.0.0.200/WSAfip/WSAFIP.asmx" binding="basicHttpBinding" bindingConfiguration="WSAFIPSoap"
                     contract="WSAFIP.WSAFIPSoap" name="WSAFIPSoap"/>
             </client>
         </system.serviceModel>
  <system.data>
    <DbProviderFactories>
      <remove invariant="Microsoft.ACE.OLEDB.12.0" />
      <add name="Microsoft Office 12.0 Access Database Engine OLE DB Provider" 
           invariant="Microsoft.ACE.OLEDB.12.0" 
           description=".NET Framework Data Provider for Microsoft Office 12.0 Access Database Engine" 
           type="System.Data.OleDb.OleDbFactory, System.Data" />
    </DbProviderFactories>
  </system.data>
</configuration>